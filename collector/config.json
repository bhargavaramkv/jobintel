{
  "$comment": "Public, non-secret collector settings. Only India-based postings with engineering titles are kept; the browser filters further using the local profile.",
  "titleFilter": {
    "include": [
      "engineer",
      "developer",
      "sde",
      "swe",
      "software",
      "programmer",
      "full stack",
      "full-stack",
      "fullstack",
      "backend",
      "back-end",
      "back end",
      ".net",
      "c#"
    ],
    "exclude": [
      "manager",
      "director",
      "head of",
      "vp",
      "vice president",
      "principal",
      "distinguished",
      "architect",
      "intern",
      "internship",
      "apprentice",
      "sales",
      "value engineer",
      "solutions engineer",
      "solution engineer",
      "sales engineer",
      "pre-sales",
      "presales",
      "customer",
      "support",
      "field engineer",
      "forward deployed",
      "hardware",
      "electrical",
      "mechanical",
      "analog",
      "asic",
      "rtl",
      "silicon",
      "firmware",
      "recruit",
      "talent"
    ]
  },
  "maxDescriptionChars": 2500,
  "closedRetentionDays": 14,
  "requestTimeoutMs": 25000,
  "concurrency": 6
}
