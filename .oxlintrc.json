{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "test-results",
    "playwright-report",
    "apps/api/src/generated"
  ]
}
